+describe('DSH_WEB_TOKEN precedence', () => {
+  it('outranks the stored token and refuses token management', async () => {
+    const store = new KeyedCredentials()
+    const configured = await BrowserAuth.create({}, credentials(store), 30)
+    await configured.setPersistentToken(RESTART_TOKEN)
+
+    process.env[ENV_TOKEN] = CUSTOM_TOKEN
+    const auth = await BrowserAuth.create({}, credentials(store), 30)
+    expect(statusOf(auth)).toMatchObject({ mode: 'environment', stable: true })
+    expect(auth.status().source).toBe('environment')
+    expect(tokenOf(auth.authenticatedUrl('http://127.0.0.1:3080'))).toBe(CUSTOM_TOKEN)
+    await expect(auth.setPersistentToken(RESTART_TOKEN)).rejects.toThrow(/DSH_WEB_TOKEN/u)
+    await expect(auth.clearPersistentToken()).rejects.toThrow(/DSH_WEB_TOKEN/u)
+
+    // The stored value stays intact for when the variable is unset.
+    delete process.env[ENV_TOKEN]
+    const restored = await BrowserAuth.create({}, credentials(store), 30)
+    expect(tokenOf(restored.authenticatedUrl('http://127.0.0.1:3080'))).toBe(RESTART_TOKEN)
+  })
+
+  it('fails load on an unusable value instead of silently ignoring it', async () => {
+    process.env[ENV_TOKEN] = 'too-short'
+    await expect(BrowserAuth.create({}, credentials(new KeyedCredentials()), 30))
+      .rejects.toThrow(/DSH_WEB_TOKEN launch token/u)
+  })
+})
