+describe('stored session records', () => {
+  it('reads a version 1 record without a rotation epoch and upgrades it on the next write', async () => {
+    const store = new KeyedCredentials()
+    await BrowserAuth.create({}, credentials(store), 30)
+    const key = [...store.records.keys()][0]!
+    const legacy = store.records.get(key)!
+    if (legacy.kind !== 'grant' || typeof legacy.payload !== 'object' || legacy.payload === null) {
+      throw new Error('unexpected record shape')
+    }
+    store.records.set(key, {
+      kind: 'grant',
+      payload: { version: 1, secret: Reflect.get(legacy.payload, 'secret') },
+    })
+
+    const reloaded = await BrowserAuth.create({}, credentials(store), 30)
+    expect(statusOf(reloaded).mode).toBe('ephemeral')
+    const migrated = await reloaded.setPersistentToken(RESTART_TOKEN)
+    expect(migrated.mode).toBe('persistent')
+    expect(store.records.get(key)).toMatchObject({
+      kind: 'grant',
+      payload: { version: 2, epoch: 1, launchToken: RESTART_TOKEN },
+    })
+  })
+
+  it('rejects a corrupted stored token instead of serving it', async () => {
+    const store = new KeyedCredentials()
+    const auth = await BrowserAuth.create({}, credentials(store), 30)
+    const key = [...store.records.keys()][0]!
+    const record = store.records.get(key)!
+    if (record.kind !== 'grant' || typeof record.payload !== 'object' || record.payload === null) {
+      throw new Error('unexpected record shape')
+    }
+    store.records.set(key, {
+      kind: 'grant',
+      payload: { ...record.payload, launchToken: 'not-valid!' },
+    })
+    await expect(BrowserAuth.create({}, credentials(store), 30)).rejects.toThrow(/invalid launch token|web launch token/u)
+    expect(auth.status().mode).toBe('ephemeral')
+  })
+})
