@@ -0,0 +1,236 @@
+/** Persistent launch-token behavior: storage, restart, rotation, and environment precedence. */
+
+import { afterEach, describe, expect, it } from 'vitest'
+import type { CredentialKey, CredentialProvider, CredentialRecord } from '@deepseek-ai/dsh-credentials'
+import { BrowserAuth } from '../src/browser-auth.ts'
+import type { ConnectionIndexRequest, ConnectionIndexResponse } from '../src/rpc.ts'
+
+const ENV_TOKEN = 'DSH_WEB_TOKEN'
+const RESTART_TOKEN = 'b'.repeat(43)
+const CUSTOM_TOKEN = 'c'.repeat(43)
+
+interface ResponseState {
+  status?: number
+  headers?: Readonly<Record<string, string>>
+}
+
+function response(): { value: ConnectionIndexResponse; state: ResponseState } {
+  const state: ResponseState = {}
+  return {
+    value: {
+      writeHead(status, headers) {
+        state.status = status
+        if (headers !== undefined) state.headers = headers
+      },
+      end() {},
+    },
+    state,
+  }
+}
+
+/** Key-aware credential double: one record per address, as the durable provider stores them. */
+class KeyedCredentials {
+  readonly records = new Map<string, CredentialRecord>()
+
+  readRecord(key: CredentialKey): Promise<CredentialRecord | undefined> {
+    return Promise.resolve(this.records.get(String(key)))
+  }
+
+  modifyRecord(
+    key: CredentialKey,
+    mutate: (current: CredentialRecord | undefined) => Promise<CredentialRecord | undefined>,
+  ): Promise<CredentialRecord | undefined> {
+    return mutate(this.records.get(String(key))).then((next) => {
+      if (next !== undefined) this.records.set(String(key), next)
+      return this.records.get(String(key))
+    })
+  }
+
+  deleteRecord(key: CredentialKey): Promise<void> {
+    this.records.delete(String(key))
+    return Promise.resolve()
+  }
+}
+
+function credentials(store: KeyedCredentials): CredentialProvider {
+  return store as unknown as CredentialProvider
+}
+
+function request(url: string, cookie?: string): ConnectionIndexRequest {
+  return {
+    method: 'GET',
+    url,
+    headers: cookie === undefined ? { host: '127.0.0.1:3080' } : { host: '127.0.0.1:3080', cookie },
+  }
+}
+
+/** Exchange a launch URL for its cookie the way the browser does. */
+function exchange(auth: BrowserAuth, base = 'http://127.0.0.1:3080'): { cookie: string; url: string } {
+  const url = auth.authenticatedUrl(base)
+  const target = new URL(url)
+  const res = response()
+  expect(auth.authorizeIndex(request(`${target.pathname}${target.search}`), res.value)).toBe(false)
+  const setCookie = res.state.headers?.['set-cookie']
+  if (setCookie === undefined) throw new Error('token exchange did not set a cookie')
+  return { cookie: setCookie.split(';', 1)[0]!, url }
+}
+
+function tokenOf(url: string): string {
+  return new URL(url).searchParams.get('token') ?? ''
+}
+
+function statusOf(auth: BrowserAuth): { mode: string; stable: boolean; masked: string } {
+  const status = auth.status()
+  return { mode: status.mode, stable: status.stable, masked: status.tokenMasked }
+}
+
+afterEach(() => {
+  delete process.env[ENV_TOKEN]
+})
+
+describe('ephemeral launch tokens', () => {
+  it('keeps the process token and reports an unstable source by default', async () => {
+    const auth = await BrowserAuth.create({}, credentials(new KeyedCredentials()), 30)
+    expect(statusOf(auth)).toMatchObject({ mode: 'ephemeral', stable: false })
+    expect(auth.status().source).toBe('none')
+    expect(auth.status().tokenMasked).not.toBe(auth.token())
+    expect(auth.status().tokenMasked.startsWith(auth.token().slice(0, 4))).toBe(true)
+  })
+})
+
+describe('persistent launch tokens', () => {
+  it('survives a restart and keeps the same sign-in URL', async () => {
+    const store = new KeyedCredentials()
+    const first = await BrowserAuth.create({}, credentials(store), 30)
+    const saved = await first.setPersistentToken(RESTART_TOKEN)
+    expect(saved).toMatchObject({ mode: 'persistent', stable: true, source: 'store' })
+    expect(tokenOf(first.authenticatedUrl('http://127.0.0.1:3080'))).toBe(RESTART_TOKEN)
+
+    // A new process owner models the next `dsh web` boot in a fresh process.
+    const restarted = await BrowserAuth.create({}, credentials(store), 30)
+    expect(statusOf(restarted)).toMatchObject({ mode: 'persistent', stable: true })
+    expect(tokenOf(restarted.authenticatedUrl('http://127.0.0.1:3080'))).toBe(RESTART_TOKEN)
+    expect(restarted.authenticatedUrl('http://127.0.0.1:3080'))
+      .toBe(first.authenticatedUrl('http://127.0.0.1:3080'))
+    expect(restarted.status().rotatedAt).toBeGreaterThan(0)
+  })
+
+  it('rejects the old link and every earlier cookie after a rotation', async () => {
+    const store = new KeyedCredentials()
+    const auth = await BrowserAuth.create({}, credentials(store), 30)
+    await auth.setPersistentToken(RESTART_TOKEN)
+    const before = exchange(auth)
+
+    const rotated = await auth.setPersistentToken(CUSTOM_TOKEN)
+    expect(rotated.mode).toBe('persistent')
+    const staleUrl = response()
+    expect(auth.authorizeIndex(request(`/?token=${RESTART_TOKEN}`), staleUrl.value)).toBe(false)
+    expect(staleUrl.state.status).toBe(401)
+    expect(auth.isAuthenticated(request('/', before.cookie))).toBe(false)
+
+    const after = exchange(auth)
+    expect(tokenOf(after.url)).toBe(CUSTOM_TOKEN)
+    expect(auth.isAuthenticated(request('/', after.cookie))).toBe(true)
+  })
+
+  it('returns to a fresh ephemeral token when the fixed token is revoked', async () => {
+    const store = new KeyedCredentials()
+    const auth = await BrowserAuth.create({}, credentials(store), 30)
+    await auth.setPersistentToken(RESTART_TOKEN)
+    const before = exchange(auth)
+
+    const cleared = await auth.clearPersistentToken()
+    expect(cleared).toMatchObject({ mode: 'ephemeral', stable: false, source: 'none' })
+    expect(auth.token()).not.toBe(RESTART_TOKEN)
+    expect(auth.isAuthenticated(request('/', before.cookie))).toBe(false)
+
+    const revoked = response()
+    expect(auth.authorizeIndex(request(`/?token=${RESTART_TOKEN}`), revoked.value)).toBe(false)
+    expect(revoked.state.status).toBe(401)
+
+    const restarted = await BrowserAuth.create({}, credentials(store), 30)
+    expect(statusOf(restarted).mode).toBe('ephemeral')
+    expect(tokenOf(restarted.authenticatedUrl('http://127.0.0.1:3080'))).not.toBe(RESTART_TOKEN)
+  })
+
+  it('validates an operator token before storing it and leaves the old one active', async () => {
+    const store = new KeyedCredentials()
+    const auth = await BrowserAuth.create({}, credentials(new KeyedCredentials()), 30)
+    await auth.setPersistentToken(RESTART_TOKEN)
+    const current = auth.authenticatedUrl('http://127.0.0.1:3080')
+
+    for (const rejected of ['short', 'x'.repeat(257), 'not url safe!', `  ${'y'.repeat(10)}  `]) {
+      await expect(auth.setPersistentToken(rejected)).rejects.toThrow(/client-connection: web launch token/u)
+      expect(auth.authenticatedUrl('http://127.0.0.1:3080')).toBe(current)
+    }
+    expect(store.records.size).toBe(0)
+  })
+})
