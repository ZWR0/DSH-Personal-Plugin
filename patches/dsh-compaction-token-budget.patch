diff --git a/packages/compaction/compaction-basic/tests/token-budget.host.spec.ts b/packages/compaction/compaction-basic/tests/token-budget.host.spec.ts
new file mode 100644
--- /dev/null
+++ b/packages/compaction/compaction-basic/tests/token-budget.host.spec.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import BasicCompactionEngine from '../src/index.ts'
+import { resolveConfig, resolveTargetPolicy } from '../src/config.ts'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+
+class BudgetProbe extends BasicCompactionEngine {
+  static override inject: string[] = []
+  budget(owner: Agent) {
+    return this.tokenBudgetPolicy(owner, resolveTargetPolicy(this.config, { provider: 'test', model: 'test' }))
+  }
+}
+
+describe('local compaction token budget', () => {
+  it('preserves defaults, applies listener caps, and restores them on unload', async () => {
+    const ctx = new Context()
+    const engine = new BudgetProbe(ctx, { auto: false })
+    const owner = {} as Agent
+    const baseline = resolveTargetPolicy(resolveConfig({}), { provider: 'test', model: 'test' })
+    expect(engine.budget(owner)).toEqual(baseline)
+    const fiber = ctx.plugin((scope: Context) => {
+      scope.on('compaction/token-budget', (payload, next) => {
+        expect(payload.agent).toBe(owner)
+        const budget = next()
+        return { headroomTokens: Math.min(budget.headroomTokens, 8192), maxTokens: 4096 }
+      })
+    })
+    try {
+      await fiber
+      expect(engine.budget(owner)).toMatchObject({ headroomTokens: 8192, maxTokens: 4096 })
+      expect(engine.config.headroomTokens).toBe(baseline.headroomTokens)
+      await fiber.dispose()
+      expect(engine.budget(owner)).toEqual(baseline)
+    } finally { await ctx.fiber.dispose() }
+  })
+
+  it('never increases smaller preset values', async () => {
+    const ctx = new Context()
+    const engine = new BudgetProbe(ctx, { auto: false, headroomTokens: 100, maxTokens: 200 })
+    ctx.on('compaction/token-budget', () => ({ headroomTokens: 8192, maxTokens: 8192 }))
+    try { expect(engine.budget({} as Agent)).toMatchObject({ headroomTokens: 100, maxTokens: 200 }) }
+    finally { await ctx.fiber.dispose() }
+  })
+
+  it.each([-1, NaN, Infinity, 1.5])('rejects invalid headroom %s', async value => {
+    const ctx = new Context()
+    const engine = new BudgetProbe(ctx, { auto: false })
+    ctx.on('compaction/token-budget', () => ({ headroomTokens: value, maxTokens: 8192 }))
+    try { expect(() => engine.budget({} as Agent)).toThrow('invalid token budget') }
+    finally { await ctx.fiber.dispose() }
+  })
+
+  it.each([0, -1, NaN, Infinity, 1.5])('rejects invalid summary cap %s', async value => {
+    const ctx = new Context()
+    const engine = new BudgetProbe(ctx, { auto: false })
+    ctx.on('compaction/token-budget', () => ({ headroomTokens: 0, maxTokens: value }))
+    try { expect(() => engine.budget({} as Agent)).toThrow('invalid token budget') }
+    finally { await ctx.fiber.dispose() }
+  })
+})
